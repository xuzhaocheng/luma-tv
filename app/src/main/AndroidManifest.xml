<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.luma.home">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/LauncherTheme">

        <!-- 主页:同时注册为 HOME,设为默认桌面后开机直接进入 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SourcePanelActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme" />

        <activity
            android:name=".SourceEditActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme" />

        <activity
            android:name=".RemoteKeyActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme" />

        <!-- 遥控器快捷键:只捕获用户学习的那一个按键,数据全在本地 -->
        <service
            android:name=".RemoteKeyService"
            android:exported="true"
            android:label="@string/remote_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application></manifest>
